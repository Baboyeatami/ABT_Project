# ---- Demo mode ----
# Set to 1 to run the whole platform in-browser with seeded data (no Supabase).
# Set to 0 and fill in the real keys below to use Supabase.
VITE_DEMO_MODE=1

# ---- Supabase (client / browser-safe) ----
# These are exposed to the browser. Do NOT put the service role key here.
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ---- Supabase (server-only, used by /api) ----
# Keep these out of the frontend bundle. Set them in Vercel's env settings.
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
